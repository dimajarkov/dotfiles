+    this.opened = !options.persistence;
+  }
+
+  /** Observe persistence readiness and failures without storing presentation state in core. */
+  subscribe = (listener: () => void) => {
+    this.listeners.add(listener);
+    return () => {
+      this.listeners.delete(listener);
+    };
+  };
+  /** Read the persistent warning displayed by the host. */
+  getWarning = () => this.failure;
+  /** Check readiness before granting native editing authority. */
+  isReady = () => this.initialized;
+  /** Read whether this review has extension-owned storage. */
+  hasPersistence() {
+    return this.options.persistence !== undefined;
+  }
+  /** Read the position used to reject asynchronous callers from an earlier revision. */
+  position(): ExtensionReviewPosition {
+    return {
+      generation: this.options.generation,
+      stateRevision: this.store.getSnapshot().stateRevision,
+    };
+  }
+  /** Advance generation only for a preserved, non-persistent mounted review. */
+  setGeneration(generation: string) {
+    this.options.generation = generation;
+  }
+  /** Notify subscribers of durable lifecycle changes. */
+  private notify() {
+    for (const listener of this.listeners) listener();
+  }
+  /** Keep a storage failure visible until a durable human transaction succeeds. */
+  private warn(error: unknown) {
+    this.failure = `Review is not durable: ${error instanceof Error ? error.message : String(error)}`;
+    this.notify();
+  }
+
+  /** Open storage exactly once before native editing starts. */
+  initialize(): Promise<void> {
+    if (this.initializationCancelled || this.retired) return Promise.resolve();
+    if (!this.initialization) {
+      this.opening = true;
+      this.initialization = this.open().finally(() => {
+        this.opening = false;
+      });
+    }
+    return this.initialization;
+  }
+
+  /** Restore a candidate without acquiring storage authority before the host commits replacement. */
+  prepare(): Promise<void> {
+    return (this.preparation ??= this.restore());
+  }
+
+  /** Resolve the owner's identity and restore only its validated checkpoint without writing it. */
+  private async restore() {
+    const opened = await this.options.persistence?.open(this.context);
+    if (this.initializationCancelled || this.retired) return;
+    if (opened) {
+      if (
+        typeof opened.reviewId !== "string" ||
+        !opened.reviewId.trim() ||
+        opened.reviewId.length > 1024
+      )
+        throw new Error("Persistence requires a bounded immutable review id.");
+      if (opened.checkpoint != null) {
+        this.committing = true;
+        try {
+          applyReviewIntent(this.store, {
+            type: "review/restore",
+            checkpoint: opened.checkpoint,
+            identity: {
+              checkoutRoot: this.context.checkoutRoot,
+              reviewId: opened.reviewId,
+              documentIdentity: this.context.documentIdentity,
+            },
+          });
+        } finally {
+          this.committing = false;
+        }
+      }
+      this.reviewId = opened.reviewId;
+      this.restoredReviewId = opened.reviewId;
+    }
+  }
+
+  /** Acknowledge the mounted candidate before granting editing and lifecycle readiness. */
+  private async open() {
+    try {
+      await this.prepare();
+      if (this.initializationCancelled || this.retired) return;
+      await this.adoptAcknowledged();
+    } catch (error) {
+      if (this.initializationCancelled || this.retired) return;
+      // Keep unreadable or foreign durable state untouched; later saves must fail closed.
+      this.reviewId = null;
+      this.warn(error);
+    }
+    if (this.initializationCancelled || this.retired) return;
+    this.initialized = true;
+    this.notify();
+  }
+
+  /** Retry a validated adoption with its original read-time authority, without rereading storage. */
+  private async adopt() {
+    this.reviewId = this.restoredReviewId;
+    const checkpoint = this.checkpoint();
+    if (checkpoint) await this.write(checkpoint);
+    this.opened = true;
+  }
+
+  /** Track an adoption acknowledgement so shutdown drains it instead of canceling initialization. */
+  private adoptAcknowledged() {
+    let tracked: Promise<void>;
+    tracked = this.adopt().finally(() => {
+      if (this.adoption === tracked) this.adoption = undefined;
+    });
+    this.adoption = tracked;
+    return tracked;
+  }
+
+  /** Capture detached native human state, including the composer and immutable source identity. */
+  checkpoint(state = this.store.getSnapshot()): ExtensionReviewCheckpoint | null {
+    if (!this.reviewId) return null;
+    const snapshot = buildExtensionReviewSnapshot(this.options.generation, state);
+    const notes = snapshot.notes
+      .filter((note) => note.source === "user")
+      .map((note) => {
+        const stored = state.userNotes.find((entry) => entry.note.id === note.id)!;
+        if (!stored.provenance)
+          throw new Error("A human note is missing its original source provenance.");
+        return { ...note, provenance: stored.provenance };
+      });
+    const selection = selectNormalizedSelection(state);
+    const serialized = JSON.stringify({
+      version: 1,
+      checkoutRoot: this.context.checkoutRoot,
+      reviewId: this.reviewId,
+      documentIdentity: this.context.documentIdentity,
+      generation: this.options.generation,
+      stateRevision: state.stateRevision,
+      notes,
+      draft: state.draftNote,
+      selection: {
+        ...selection,
+        activeNoteId: state.userNotes.some((entry) => entry.note.id === state.activeNoteId)
+          ? state.activeNoteId
+          : null,
+      },
+    });
+    if (notes.length > 2048 || utf8ByteLength(serialized) > MAX_REVIEW_CHECKPOINT_BYTES)
+      throw new Error("Review checkpoint exceeds its size limit.");
+    return freezeCheckpoint(JSON.parse(serialized) as ExtensionReviewCheckpoint);
+  }
+
+  /** Drain acknowledged writes and reject recovery when persistence still has no owner. */
+  private async drain() {
+    await this.tail;
+    if (!this.opened)
+      throw new ReviewTransitionError("failed", this.failure ?? "Checkpoint restoration failed.");
+  }
+
+  /** Serialize checkpoint acknowledgements so a draft cannot overwrite a later human save. */
+  private write(checkpoint: ExtensionReviewCheckpoint): Promise<void> {
+    const pending = this.tail.then(() => this.acknowledge(checkpoint));
+    this.tail = pending.catch(() => {});
+    return pending;
+  }
+
+  /** Skip only this controller's already acknowledged whole checkpoint, never competing edits. */
+  private async acknowledge(checkpoint: ExtensionReviewCheckpoint): Promise<void> {
+    const serialized = JSON.stringify(checkpoint);
+    if (serialized === this.acknowledgedCheckpoint) return;
+    await this.options.persistence!.write(checkpoint);
+    this.acknowledgedCheckpoint = serialized;
+  }
+
+  /** Apply synchronous editing; store admission prevents bypassing durable human transactions. */
+  apply<T extends ReviewIntent>(
+    intent: T,
+    facts?: ReviewIntentFacts,
+  ): ReviewIntentOutcomeByType[T["type"]] {
+    if (!this.initialized || this.retired) throw new Error("The review is unavailable.");
+    return applyReviewIntent(this.store, intent, facts);
+  }
+
+  /** Coalesce draft and selection changes behind at most one admitted background write. */
+  private persistCurrent() {
+    if (!this.reviewId || this.retired || this.committing) return;
+    this.draftDirty = true;
+    if (this.pendingDraftWrite || this.saving) return;
+    this.pendingDraftWrite = true;
+    const pending = this.tail.then(async () => {
+      this.draftDirty = false;
+      const checkpoint = this.checkpoint();
+      if (checkpoint) await this.acknowledge(checkpoint);
+    });
+    this.tail = pending
+      .catch((error) => this.warn(error))
+      .finally(() => {
+        this.pendingDraftWrite = false;
+        if (this.draftDirty && !this.saving) this.persistCurrent();
+      });
+  }
+
+  /** Await durable acknowledgement before consuming the composer or publishing a human mutation. */
+  async save<T extends ReviewIntent>(
+    intent: T,
+    facts?: ReviewIntentFacts,
+  ): Promise<ReviewIntentOutcomeByType[T["type"]] | null> {
+    if (!this.initialized || this.retired || this.saving) return null;
+    this.saving = true;
+    this.activityRevision++;
+    try {
+      if (!this.opened)
+        throw new Error(
+          "The existing checkpoint could not be validated; it will not be overwritten.",
+        );
+      const state = this.store.getSnapshot();
+      const plan = planReviewIntent(state, intent, facts);
+      const next = plan.actions.reduce(reduceReviewState, state);
+      const checkpoint = this.checkpoint({
+        ...next,
+        stateRevision: state.stateRevision + plan.actions.length,
+      });
+      if (checkpoint) await this.write(checkpoint);
+      const currentState = this.store.getSnapshot();
+      if (
+        currentState.document !== state.document ||
+        currentState.draftNote !== state.draftNote ||
+        currentState.userNotes !== state.userNotes ||
+        currentState.liveNotes !== state.liveNotes
+      ) {
+        // A newer composer remains authoritative even if storage acknowledged the captured text.
+        const current = this.checkpoint();
+        if (current) await this.write(current);
+        throw new Error(
+          "Review changed while saving; the newer composer was retained. Save again.",
+        );
+      }
+      this.committing = true;
+      for (const action of plan.actions) this.store.dispatch(action);
+      this.failure = null;
+      this.draftDirty = currentState !== state;
+      return plan.outcome as ReviewIntentOutcomeByType[T["type"]];
+    } catch (error) {
+      this.warn(error);
+      return null;
+    } finally {
+      this.committing = false;
+      this.saving = false;
+      if (this.draftDirty) this.persistCurrent();
+      this.notify();
+    }
+  }
+
+  /** Durably change only a native human note at the exact caller-observed revision. */
+  async setNoteStatus(
+    noteId: string,
+    status: "open" | "resolved",
+    expected: ExtensionReviewPosition,
+  ): Promise<ExtensionReviewMutationResult> {
+    try {
+      if (
+        !expected ||
+        typeof expected.generation !== "string" ||
+        !Number.isSafeInteger(expected.stateRevision) ||
+        expected.stateRevision < 0
+      )
+        return {
+          ok: false,
+          reason: "failed",
+          detail: "A human mutation requires the captured review generation and revision.",
+        };
+      this.checkExpected(expected);
+      if (this.saving || this.editorCount || this.store.getSnapshot().draftNote)
+        return { ok: false, reason: "busy", detail: "Finish the current composer or save first." };
+      const result = await this.save({ type: "notes/set-user-status", noteId, status });
+      return result === null
+        ? { ok: false, reason: "failed", detail: this.failure ?? "The human note was not saved." }
+        : { ok: true };
+    } catch (error) {
+      return {
+        ok: false,
+        reason:
+          error instanceof ReviewTransitionError
+            ? error.reason === "protected"
+              ? "busy"
+              : error.reason
+            : "failed",
+        detail: String(error),
+      };
+    }
+  }
+
+  /** Reject stale callers before starting and again before committing replacement. */
+  private checkExpected(expected?: ExtensionReviewPosition) {
+    const position = this.position();
+    if (
+      this.retired ||
+      (expected &&
+        (expected.generation !== position.generation ||
+          expected.stateRevision !== position.stateRevision))
+    )
+      throw new ReviewTransitionError("conflict", "The review generation or revision changed.");
+  }
+
+  /** Admit a replacement only while native human work is safely checkpointed. */
+  async prepareTransition(
+    options: ExtensionReviewReloadOptions = {},
+  ): Promise<ReviewTransitionTicket> {
+    this.checkExpected(options.expected);
+    if (!this.initialized || this.saving || this.editorCount || this.store.getSnapshot().draftNote)
+      throw new ReviewTransitionError(
+        "busy",
+        "The review has an active composer, editor, or pending save.",
+      );
+    const acknowledged = new Set(options.acknowledgedNotes ?? []);
+    const notes = this.store.getSnapshot().userNotes;
+    if (
+      (acknowledged.size && !options.expected) ||
+      [...acknowledged].some((id) => !notes.some((entry) => entry.note.id === id))
+    )
+      throw new ReviewTransitionError(
+        "failed",
+        "Acknowledgement requires exact captured human identities and an expected review position.",
+      );
+    if (
+      options.mode !== "explicit" &&
+      notes.some((entry) => entry.status !== "resolved" && !acknowledged.has(entry.note.id))
+    )
+      throw new ReviewTransitionError(
+        "protected",
+        "Open unacknowledged human notes protect this review from automatic replacement.",
+      );
+    const ticket = { ...this.position(), activityRevision: this.activityRevision };
+    if (!this.opened && this.restoredReviewId) {
+      this.initialized = false;
+      const adoption = this.adoptAcknowledged();
+      this.notify();
+      try {
+        try {
+          await adoption;
+          this.failure = null;
+        } catch (error) {
+          this.reviewId = null;
+          this.warn(error);
+          throw new ReviewTransitionError("failed", this.failure!);
+        }
+        await this.drain();
+      } finally {
+        this.initialized = true;
+        this.notify();
+      }
+    } else {
+      await this.flush();
+    }
+    this.validateTransition(ticket);
+    return ticket;
+  }
+
+  /** Recheck the ticket synchronously at the host's existing publication commit gate. */
+  validateTransition(ticket: ReviewTransitionTicket) {
+    this.checkExpected(ticket);
+    if (
+      this.saving ||
+      this.editorCount ||
+      this.store.getSnapshot().draftNote ||
+      ticket.activityRevision !== this.activityRevision
+    )
+      throw new ReviewTransitionError(
+        "conflict",
+        "Native editing or saving changed during review loading.",
+      );
+  }
+
+  /** Protect asynchronous reload preparation across a native source-editor session. */
+  beginEditor() {
+    this.editorCount++;
+    this.activityRevision++;
+    let finished = false;
+    return () => {
+      if (!finished) {
+        finished = true;
+        this.editorCount--;
+        this.activityRevision++;
+      }
+    };
+  }
+
+  /** Revoke outgoing mutation authority after its replacement commits. */
+  retire() {
+    this.retired = true;
+  }
+
+  /** Drain admitted writes, checkpoint ready reviews, and cancel an owner open that has not queued its first write. */
+  async flush() {
+    if (!this.initialized && !this.adoption) {
+      // An unresolved owner open has not admitted a write and cannot hold process shutdown.
+      this.initializationCancelled = true;
+      this.retired = true;
+      return;
+    }
+    if (this.opening) await this.initialization;
+    else if (this.adoption) await this.adoption;
+    await this.drain();
+    const checkpoint = this.checkpoint();
+    if (checkpoint) {
+      try {
+        await this.write(checkpoint);
+      } catch (error) {
+        this.warn(error);
+        throw new ReviewTransitionError("failed", this.failure!);
+      }
+    }
+  }
+}
