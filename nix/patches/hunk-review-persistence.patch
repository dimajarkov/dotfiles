+import { expect, test } from "bun:test";
+import { join } from "node:path";
+import type {
+  ExtensionReviewCheckpoint,
+  ExtensionReviewPersistence,
+} from "../../extension-api/types";
+import { createTestReviewDocument } from "../../../../../test/helpers/review-store-helpers";
+import { ReviewController } from "./controller";
+
+/** Give each viewer its own optimistic version over one shared durable checkpoint. */
+function createTestPersistence() {
+  let checkpoint: ExtensionReviewCheckpoint | null = null;
+  let version = 0;
+  const writes: ExtensionReviewCheckpoint[] = [];
+  return {
+    read: () => ({ checkpoint, version }),
+    writes,
+    viewer(): ExtensionReviewPersistence {
+      let expectedVersion = 0;
+      return {
+        async open() {
+          expectedVersion = version;
+          return { reviewId: "immutable-review", checkpoint };
+        },
+        async write(value) {
+          if (expectedVersion !== version) throw new Error("Competing checkpoint write");
+          checkpoint = value;
+          expectedVersion = ++version;
+          writes.push(value);
+        },
+      };
+    },
+  };
+}
+
+/** Mount the same immutable source in a fresh native controller generation. */
+function createTestController(generation: string, persistence: ExtensionReviewPersistence) {
+  return new ReviewController({
+    document: createTestReviewDocument(["alpha", "beta"]),
+    checkoutRoot: join("fixture", "checkout"),
+    sourceLabel: "immutable-source",
+    generation,
+    persistence,
+  });
+}
+
+/** Save one human note using the same intents and caller facts as native Ctrl-S. */
+async function saveTestNote(controller: ReviewController) {
+  controller.apply(
+    { type: "notes/start-draft", fileKey: "alpha", hunkIndex: 0, target: { side: "new", line: 2 } },
+    { draftId: "draft:human" },
+  );
+  controller.apply({ type: "notes/update-draft", body: "Saved human request" });
+  expect(
+    await controller.save(
+      { type: "notes/create-user", consumeDraft: true },
+      { noteId: "human", timestamp: "2026-10-12T00:00:00Z" },
+    ),
+  ).not.toBeNull();
+  await controller.flush();
+}
+
+test("a restored candidate does not acquire storage authority until mounted initialization", async () => {
+  const storage = createTestPersistence();
+  const previous = createTestController("generation-1", storage.viewer());
+  await previous.initialize();
+  await saveTestNote(previous);
+  const before = storage.read();
+  const candidate = createTestController("generation-2", storage.viewer());
+  await candidate.prepare();
+  expect(candidate.isReady()).toBe(false);
+  expect(storage.read()).toEqual(before);
+  const ticket = await previous.prepareTransition({ mode: "explicit" });
+  const finishEditor = previous.beginEditor();
+  finishEditor();
+  expect(() => previous.validateTransition(ticket)).toThrow("Native editing or saving changed");
+  previous.apply({ type: "notes/start-edit", noteId: "human" }, { draftId: "still-mounted" });
+  previous.apply({ type: "notes/update-draft", body: "Saved after canceled preparation" });
+  expect(
+    await previous.save(
+      { type: "notes/update-user", noteId: "human", consumeDraft: true },
+      { timestamp: "2026-10-12T00:01:00Z" },
+    ),
+  ).not.toBeNull();
+  await previous.flush();
+  expect(storage.read().checkpoint!.generation).toBe("generation-1");
+  expect(storage.read().checkpoint!.notes[0]!.summary).toBe("Saved after canceled preparation");
+});
+
+test("a mounted failed adoption can retry with its original authority before the next reload", async () => {
+  const storage = createTestPersistence();
+  const previous = createTestController("generation-1", storage.viewer());
+  await previous.initialize();
+  await saveTestNote(previous);
+  const before = storage.read();
+  let unavailable = true;
+  const owner = storage.viewer();
+  const mounted = createTestController("generation-2", {
+    open: owner.open,
+    async write(checkpoint) {
+      if (unavailable) throw new Error("Transient checkpoint failure");
+      await owner.write(checkpoint);
+    },
+  });
+  await mounted.prepare();
+  previous.retire();
+  await mounted.initialize();
+  expect(mounted.getWarning()).toContain("Transient checkpoint failure");
+  expect(mounted.checkpoint()).toBeNull();
+  expect(storage.read()).toEqual(before);
+  unavailable = false;
+  const ticket = await mounted.prepareTransition({ mode: "explicit" });
+  mounted.validateTransition(ticket);
+  expect(mounted.getWarning()).toBeNull();
+  expect(storage.read().checkpoint).toEqual(mounted.checkpoint());
+  expect(storage.read().checkpoint!.notes).toEqual(before.checkpoint!.notes);
+});
+
+test("retrying a failed mounted adoption cannot refresh a competing writer's CAS authority", async () => {
+  const storage = createTestPersistence();
+  const original = createTestController("generation-1", storage.viewer());
+  await original.initialize();
+  let unavailable = true;
+  const owner = storage.viewer();
+  const mounted = createTestController("generation-2", {
+    open: owner.open,
+    async write(checkpoint) {
+      if (unavailable) throw new Error("Transient checkpoint failure");
+      await owner.write(checkpoint);
+    },
+  });
+  await mounted.initialize();
+  const competing = createTestController("generation-other", storage.viewer());
+  await competing.initialize();
+  const beforeRetry = storage.read();
+  unavailable = false;
+  await expect(mounted.prepareTransition({ mode: "explicit" })).rejects.toThrow(
+    "Competing checkpoint write",
+  );
+  expect(mounted.checkpoint()).toBeNull();
+  expect(storage.read()).toEqual(beforeRetry);
+});
+
+test("restoration acknowledges the rehydrated native position, selection and edit draft before readiness", async () => {
+  const storage = createTestPersistence();
+  const original = createTestController("generation-1", storage.viewer());
+  await original.initialize();
+  await saveTestNote(original);
+  original.apply({ type: "notes/start-edit", noteId: "human" }, { draftId: "draft:edit" });
+  original.apply({ type: "notes/update-draft", body: "Unsaved edit" });
+  await original.flush();
+  const before = original.checkpoint()!;
+  let acknowledge!: () => void;
+  const gate = new Promise<void>((resolve) => {
+    acknowledge = resolve;
+  });
+  const owner = storage.viewer();
+  let adopted: ExtensionReviewCheckpoint | undefined;
+  const restored = createTestController("generation-2", {
+    open: owner.open,
+    async write(checkpoint) {
+      adopted = checkpoint;
+      await gate;
+      await owner.write(checkpoint);
+    },
+  });
+  const initialization = restored.initialize();
+  await Bun.sleep(0);
+  expect(adopted).toMatchObject({ generation: "generation-2", stateRevision: 1 });
+  expect(restored.isReady()).toBe(false);
+  acknowledge();
+  await initialization;
+  expect(restored.isReady()).toBe(true);
+  expect(storage.read().checkpoint).toEqual(restored.checkpoint());
+  expect(restored.checkpoint()).toMatchObject({
+    notes: before.notes,
+    draft: before.draft,
+    selection: before.selection,
+  });
+  expect(restored.checkpoint()!.notes).toHaveLength(1);
+});
+
+test("closing the unchanged previous viewer neither advances storage nor defeats the new viewer's edit", async () => {
+  const storage = createTestPersistence();
+  const previous = createTestController("split", storage.viewer());
+  await previous.initialize();
+  await saveTestNote(previous);
+  const tab = createTestController("tab", storage.viewer());
+  await tab.initialize();
+  const adopted = storage.read();
+  expect(adopted.checkpoint).toEqual(tab.checkpoint());
+  await previous.flush();
+  expect(storage.read()).toEqual(adopted);
+  tab.apply({ type: "notes/start-edit", noteId: "human" }, { draftId: "draft:tab-edit" });
+  tab.apply({ type: "notes/update-draft", body: "Edited in full-width tab" });
+  expect(
+    await tab.save(
+      { type: "notes/update-user", noteId: "human", consumeDraft: true },
+      { timestamp: "2026-10-12T00:01:00Z" },
+    ),
+  ).not.toBeNull();
+  await tab.flush();
+  expect(tab.getWarning()).toBeNull();
+  expect(storage.read().checkpoint).toMatchObject({
+    notes: [{ id: "human", summary: "Edited in full-width tab" }],
+    draft: null,
+  });
+  const version = storage.read().version;
+  await previous.flush();
+  await tab.flush();
+  expect(storage.read().version).toBe(version);
+});
+
+test("a competing old-view composer remains visible and cannot overwrite the adopted tab", async () => {
+  const storage = createTestPersistence();
+  const previous = createTestController("split", storage.viewer());
+  await previous.initialize();
+  await saveTestNote(previous);
+  const tab = createTestController("tab", storage.viewer());
+  await tab.initialize();
+  const adopted = storage.read();
+  previous.apply({ type: "notes/start-edit", noteId: "human" }, { draftId: "draft:competing" });
+  previous.apply({ type: "notes/update-draft", body: "Competing unsaved edit" });
+  await expect(previous.flush()).rejects.toThrow("Competing checkpoint write");
+  expect(previous.store.getSnapshot().draftNote?.body).toBe("Competing unsaved edit");
+  expect(previous.getWarning()).toContain("Competing checkpoint write");
+  expect(storage.read()).toEqual(adopted);
+});
+
+test("failed restore acknowledgement preserves the durable checkpoint and refuses later saves", async () => {
+  const storage = createTestPersistence();
+  const previous = createTestController("split", storage.viewer());
+  await previous.initialize();
+  await saveTestNote(previous);
+  const before = storage.read();
+  const owner = storage.viewer();
+  const tab = createTestController("tab", {
+    open: owner.open,
+    async write() {
+      throw new Error("Storage unavailable");
+    },
+  });
+  await tab.initialize();
+  expect(tab.getWarning()).toContain("Storage unavailable");
+  expect(tab.checkpoint()).toBeNull();
+  expect(tab.store.getSnapshot().userNotes[0]?.note.id).toBe("human");
+  tab.apply({ type: "notes/start-edit", noteId: "human" }, { draftId: "draft:held" });
+  tab.apply({ type: "notes/update-draft", body: "Keep my local edit" });
+  expect(
+    await tab.save(
+      { type: "notes/update-user", noteId: "human", consumeDraft: true },
+      { timestamp: "2026-10-12T00:01:00Z" },
+    ),
+  ).toBeNull();
+  expect(tab.store.getSnapshot().draftNote?.body).toBe("Keep my local edit");
+  expect(storage.read()).toEqual(before);
+});
+
+test("recovery acknowledgement reserves native readiness and releases it after failure", async () => {
+  const owner = createTestPersistence().viewer();
+  let writes = 0;
+  let recoveryStarted!: () => void;
+  const started = new Promise<void>((resolve) => {
+    recoveryStarted = resolve;
+  });
+  let releaseRecovery!: () => void;
+  const recoveryGate = new Promise<void>((resolve) => {
+    releaseRecovery = resolve;
+  });
+  let failRecovery = true;
+  const controller = createTestController("mounted", {
+    open: owner.open,
+    async write(checkpoint) {
+      writes++;
+      if (writes === 1) throw new Error("Initial acknowledgement failed");
+      if (writes === 2) {
+        recoveryStarted();
+        await recoveryGate;
+        if (failRecovery) throw new Error("Recovery acknowledgement failed");
+      }
+      await owner.write(checkpoint);
+    },
+  });
+  await controller.initialize();
+  expect(controller.isReady()).toBe(true);
+  const before = controller.store.getSnapshot();
+  let recovery: Promise<unknown> | undefined;
+
+  try {
+    recovery = controller.prepareTransition({ mode: "explicit" });
+    await started;
+    expect(controller.isReady()).toBe(false);
+    expect(controller.store.getSnapshot()).toBe(before);
+    expect(() =>
+      controller.apply(
+        { type: "notes/start-draft", fileKey: "alpha", hunkIndex: 0 },
+        { draftId: "blocked-draft" },
+      ),
+    ).toThrow("The review is unavailable.");
+
+    releaseRecovery();
+    await expect(recovery).rejects.toThrow("Recovery acknowledgement failed");
+    expect(controller.isReady()).toBe(true);
+    expect(controller.store.getSnapshot()).toBe(before);
+    expect(controller.checkpoint()).toBeNull();
+    expect(controller.getWarning()).toContain("Recovery acknowledgement failed");
+
+    failRecovery = false;
+    const ticket = await controller.prepareTransition({ mode: "explicit" });
+    controller.validateTransition(ticket);
+    expect(controller.isReady()).toBe(true);
+    expect(controller.getWarning()).toBeNull();
+  } finally {
+    releaseRecovery();
+    await recovery?.catch(() => {});
+  }
+});
+
+test("graceful flush cancels an unresolved storage open before it can acknowledge", async () => {
+  let openStarted!: () => void;
+  const started = new Promise<void>((resolve) => {
+    openStarted = resolve;
+  });
+  let releaseOpen!: () => void;
+  const gate = new Promise<void>((resolve) => {
+    releaseOpen = resolve;
+  });
+  let writes = 0;
+  let notifications = 0;
+  const controller = createTestController("initial", {
+    async open() {
+      openStarted();
+      await gate;
+      return { reviewId: "immutable-review", checkpoint: null };
+    },
+    async write() {
+      writes++;
+    },
+  });
+  controller.subscribe(() => notifications++);
+  const initialization = controller.initialize();
+  await started;
+
+  await controller.flush();
+  expect(controller.isReady()).toBe(false);
+  expect(notifications).toBe(0);
+
+  releaseOpen();
+  await initialization;
+  expect(writes).toBe(0);
+  expect(controller.isReady()).toBe(false);
+  expect(controller.getWarning()).toBeNull();
+  expect(notifications).toBe(0);
+});
+
+test("canceled initialization suppresses a late storage-open failure", async () => {
+  let openStarted!: () => void;
+  const started = new Promise<void>((resolve) => {
+    openStarted = resolve;
+  });
+  let releaseOpen!: () => void;
+  const gate = new Promise<void>((resolve) => {
+    releaseOpen = resolve;
+  });
+  let notifications = 0;
+  const controller = createTestController("initial", {
+    async open() {
+      openStarted();
+      await gate;
+      throw new Error("Storage open failed after shutdown");
+    },
+    async write() {
+      throw new Error("Canceled initialization must not write.");
+    },
+  });
+  controller.subscribe(() => notifications++);
+  const initialization = controller.initialize();
+  await started;
+  await controller.flush();
+
+  releaseOpen();
+  await initialization;
+  expect(controller.isReady()).toBe(false);
+  expect(controller.getWarning()).toBeNull();
+  expect(notifications).toBe(0);
+});
+
+test("graceful flush waits for an in-flight initial acknowledgement before checking readiness", async () => {
+  let writeStarted!: () => void;
+  const started = new Promise<void>((resolve) => {
+    writeStarted = resolve;
+  });
+  let acknowledge!: () => void;
+  const gate = new Promise<void>((resolve) => {
+    acknowledge = resolve;
+  });
+  const controller = createTestController("initial", {
+    async open() {
+      return { reviewId: "immutable-review", checkpoint: null };
+    },
+    async write() {
+      writeStarted();
+      await gate;
+    },
+  });
+  const initialization = controller.initialize();
+  await started;
+  let flushed = false;
+  const shutdown = controller.flush().then(() => {
+    flushed = true;
+  });
+  await Promise.resolve();
+  expect(flushed).toBe(false);
+  acknowledge();
+  await Promise.all([initialization, shutdown]);
+  expect(controller.isReady()).toBe(true);
+  expect(flushed).toBe(true);
+});
diff --git a/packages/hunk/src/core/review/controller.ts b/packages/hunk/src/core/review/controller.ts
new file mode 100644
index 00000000..83110f51
--- /dev/null
+++ b/packages/hunk/src/core/review/controller.ts
@@ -0,0 +1,551 @@
+/**
+ * Coordinates native note saves, durable restoration, and review replacement.
+ * Composer edits and remote review intents share the store; extension-owned storage acknowledges
+ * human transactions before they publish. Source loading stays with the host's reload coordinator.
+ */
+import type {
+  ExtensionReviewCheckpoint,
+  ExtensionReviewMutationResult,
+  ExtensionReviewPersistence,
+  ExtensionReviewPersistenceContext,
+  ExtensionReviewPosition,
+  ExtensionReviewReloadOptions,
+} from "../../extension-api/types";
+import type { ReviewAction } from "./actions";
+import { MAX_REVIEW_CHECKPOINT_BYTES } from "./checkpoint";
+import { utf8ByteLength } from "./validation";
+import { reviewContentDigest } from "./identity";
+import {
+  applyReviewIntent,
+  planReviewIntent,
+  type ReviewIntent,
+  type ReviewIntentFacts,
+  type ReviewIntentOutcomeByType,
+} from "./intents";
+import { reduceReviewState } from "./reducer";
+import { selectNormalizedSelection } from "./selectors";
+import { buildExtensionReviewSnapshot } from "./snapshot";
+import { createReviewStore, type ReviewStore } from "./store";
+import type { ReviewDocumentV1 } from "./types";
+
+/** Freeze a detached JSON value before handing storage ownership to an extension. */
+function freezeCheckpoint<T>(value: T): T {
+  if (value && typeof value === "object") {
+    for (const child of Object.values(value)) freezeCheckpoint(child);
+    Object.freeze(value);
+  }
+  return value;
+}
+
+export interface ReviewControllerOptions {
+  document: ReviewDocumentV1;
+  checkoutRoot: string;
+  sourceLabel: string;
+  generation: string;
+  persistence?: ExtensionReviewPersistence;
+  showAgentNotes?: boolean;
+}
+
+/** Report a guarded refusal using the same vocabulary as public review controls. */
+export class ReviewTransitionError extends Error {
+  constructor(
+    readonly reason: "conflict" | "busy" | "protected" | "failed",
+    message: string,
+  ) {
+    super(message);
+  }
+}
+
+/** A commit ticket records state and editor activity before the host awaits source loading. */
+export interface ReviewTransitionTicket {
+  readonly generation: string;
+  readonly stateRevision: number;
+  readonly activityRevision: number;
+}
+
+/** Identify mutations that require durable acknowledgement rather than synchronous admission. */
+function durableHumanAction(action: ReviewAction) {
+  return (
+    action.type === "draft/save" ||
+    action.type === "draft/save-edit" ||
+    action.type === "notes/remove-user" ||
+    action.type === "notes/set-user-status" ||
+    (action.type === "notes/clear" && action.includeUser === true)
+  );
+}
+
+/** Own one review's durable transactions without coupling core to storage or a renderer. */
+export class ReviewController {
+  readonly store: ReviewStore;
+  readonly context: ExtensionReviewPersistenceContext;
+  private reviewId: string | null = null;
+  private tail: Promise<void> = Promise.resolve();
+  private saving = false;
+  private committing = false;
+  private pendingDraftWrite = false;
+  private draftDirty = false;
+  private failure: string | null = null;
+  private listeners = new Set<() => void>();
+  private initialization: Promise<void> | undefined;
+  private initializationCancelled = false;
+  private opening = false;
+  private adoption: Promise<void> | undefined;
+  private preparation: Promise<void> | undefined;
+  private restoredReviewId: string | null = null;
+  private initialized = false;
+  private opened = false;
+  private retired = false;
+  private editorCount = 0;
+  private activityRevision = 0;
+  private acknowledgedCheckpoint: string | undefined;
+
+  constructor(private readonly options: ReviewControllerOptions) {
+    const store = createReviewStore(options.document, { showAgentNotes: options.showAgentNotes });
+    this.store = {
+      getSnapshot: store.getSnapshot,
+      subscribe: store.subscribe,
+      dispatch: (action) => {
+        if (this.retired) throw new Error("This review has retired.");
+        if (!this.committing && this.options.persistence && durableHumanAction(action)) {
+          throw new Error("Durable human mutations require the awaited review controller.");
+        }
+        const before = store.getSnapshot();
+        const next = store.dispatch(action);
+        if (!this.committing && before !== next) this.persistCurrent();
+        return next;
+      },
+    };
+    const snapshot = buildExtensionReviewSnapshot(options.generation, store.getSnapshot());
+    this.context = freezeCheckpoint({
+      checkoutRoot: options.checkoutRoot,
+      sourceLabel: options.sourceLabel,
+      documentIdentity: reviewContentDigest(
+        snapshot.files.flatMap((file) => [
+          file.fileKey,
+          file.contentIdentity,
+          file.sourceIdentity ?? "",
+          String(file.sourceAttested === true),
+        ]),
+      ),
+      files: snapshot.files,
+    });
