+/** Validates durable native human state against the exact review being restored. */
+import { resolveReviewExpandedLine, reviewGapId } from "./expansion";
+import type { ExtensionReviewCheckpoint } from "../../extension-api/types";
+import { reviewLineCoveredByHunks, reviewRangeTargetCoverageIssue } from "./geometry";
+import { MAX_REVIEW_NOTE_BYTES, reviewNoteWithinSizeLimit } from "./noteSize";
+import { reconcileStoredReviewNote, reviewRangeContext } from "./reconciliation";
+import type { ReviewDraftNote, ReviewState, ReviewStoredNote } from "./state";
+import { asRecord, hasExactKeys, utf8ByteLength } from "./validation";
+
+/** Bound owner-supplied checkpoints independently from session transport budgets. */
+export const MAX_REVIEW_CHECKPOINT_BYTES = 4 * 1024 * 1024;
+
+/** Require exact fields while allowing only explicitly optional fields that are present. */
+function exact(value: unknown, required: string[], optional: string[] = []) {
+  const record = asRecord(value);
+  if (!record || !hasExactKeys(record, [...required, ...optional.filter((key) => key in record)]))
+    throw new Error("Invalid review checkpoint fields.");
+  return record;
+}
+
+/** Require a bounded identity or free-form note string. */
+function text(value: unknown, maximum = 1024): asserts value is string {
+  if (typeof value !== "string" || !value.length || utf8ByteLength(value) > maximum)
+    throw new Error("Invalid review checkpoint text.");
+}
+
+/** Accept source coordinates only, never renderer positions. */
+function index(value: unknown, minimum = 0): asserts value is number {
+  if (!Number.isSafeInteger(value) || (value as number) < minimum)
+    throw new Error("Invalid review checkpoint coordinate.");
+}
+
+/** Validate original ranges and ownership without recomputing or relocating them. */
+function anchor(value: unknown) {
+  const record = exact(
+    value,
+    ["intersectingHunkIndices"],
+    ["oldRange", "newRange", "preferred", "ownerHunkIndex"],
+  );
+  for (const side of ["oldRange", "newRange"]) {
+    const range = record[side];
+    if (range === undefined) continue;
+    if (!Array.isArray(range) || range.length !== 2) throw new Error("Invalid checkpoint range.");
+    index(range[0], 1);
+    index(range[1], range[0]);
+  }
+  if (!record.oldRange && !record.newRange)
+    throw new Error("A restored note requires an original range.");
+  if (
+    !Array.isArray(record.intersectingHunkIndices) ||
+    record.intersectingHunkIndices.length > 10000
+  )
+    throw new Error("Invalid checkpoint hunk ownership.");
+  record.intersectingHunkIndices.forEach((value) => index(value));
+  if (record.ownerHunkIndex !== undefined) index(record.ownerHunkIndex);
+  if (record.preferred !== undefined) {
+    const preferred = exact(record.preferred, ["side", "line"]);
+    if (preferred.side !== "old" && preferred.side !== "new")
+      throw new Error("Invalid checkpoint side.");
+    index(preferred.line, 1);
+    const range = record[preferred.side === "old" ? "oldRange" : "newRange"] as
+      | number[]
+      | undefined;
+    if (!range || preferred.line < range[0]! || preferred.line > range[1]!)
+      throw new Error("Checkpoint preferred line lies outside its range.");
+  }
+}
+
+/** Restore only the checkpoint belonging to this canonical checkout and immutable source. */
+export function restoreReviewCheckpoint(
+  state: ReviewState,
+  value: unknown,
+  identity: { checkoutRoot: string; reviewId: string; documentIdentity: string },
+): Pick<ReviewState, "userNotes" | "draftNote" | "selection" | "activeNoteId"> {
+  const serialized = JSON.stringify(value);
+  if (!serialized || utf8ByteLength(serialized) > MAX_REVIEW_CHECKPOINT_BYTES)
+    throw new Error("Review checkpoint exceeds its size limit.");
+  const copy = JSON.parse(serialized) as unknown;
+  const record = exact(copy, [
+    "version",
+    "checkoutRoot",
+    "reviewId",
+    "documentIdentity",
+    "generation",
+    "stateRevision",
+    "notes",
+    "draft",
+    "selection",
+  ]);
+  if (
+    record.version !== 1 ||
+    record.checkoutRoot !== identity.checkoutRoot ||
+    record.reviewId !== identity.reviewId ||
+    record.documentIdentity !== identity.documentIdentity
+  )
+    throw new Error("Checkpoint does not match this checkout and immutable review source.");
+  text(record.generation);
+  index(record.stateRevision);
+  if (!Array.isArray(record.notes) || record.notes.length > 2048)
+    throw new Error("Invalid checkpoint note collection.");
+  const ids = new Set<string>();
+  const userNotes: ReviewStoredNote[] = record.notes.map((value) => {
+    const note = exact(
+      value,
+      [
+        "id",
+        "source",
+        "fileKey",
+        "anchor",
+        "summary",
+        "editable",
+        "resolution",
+        "provenance",
+        "filePath",
+        "fileAvailability",
+      ],
+      [
+        "status",
+        "parentId",
+        "originalSource",
+        "rationale",
+        "markup",
+        "title",
+        "author",
+        "createdAt",
+        "updatedAt",
+        "tags",
+        "confidence",
+      ],
+    );
+    text(note.id);
+    text(note.fileKey);
+    text(note.summary, MAX_REVIEW_NOTE_BYTES);
+    if (ids.has(note.id)) throw new Error("Duplicate restored human note identity.");
+    ids.add(note.id);
+    if (
+      note.source !== "user" ||
+      note.editable !== true ||
+      (note.originalSource !== undefined && note.originalSource !== "user")
+    )
+      throw new Error("Checkpoints may restore only native human notes.");
+    if (!["active", "stale", "orphaned"].includes(String(note.resolution)))
+      throw new Error("Invalid checkpoint note resolution.");
+    if (note.status !== undefined && note.status !== "open" && note.status !== "resolved")
+      throw new Error("Invalid human note status.");
+    text(note.filePath);
+    if (note.fileAvailability !== "available" && note.fileAvailability !== "unavailable")
+      throw new Error("Invalid checkpoint file availability.");
+    anchor(note.anchor);
+    for (const key of [
+      "parentId",
+      "rationale",
+      "markup",
+      "title",
+      "author",
+      "createdAt",
+      "updatedAt",
+    ])
+      if (note[key] !== undefined) text(note[key], MAX_REVIEW_NOTE_BYTES);
+    if (
+      note.tags !== undefined &&
+      (!Array.isArray(note.tags) || note.tags.some((tag) => typeof tag !== "string"))
+    )
+      throw new Error("Invalid checkpoint tags.");
+    if (
+      note.confidence !== undefined &&
+      !["low", "medium", "high"].includes(String(note.confidence))
+    )
+      throw new Error("Invalid checkpoint confidence.");
+    const provenance = exact(
+      note.provenance,
+      ["filePath", "contentIdentity"],
+      ["sourceIdentity", "sourceAttested", "oldContext", "newContext"],
+    );
+    text(provenance.filePath, MAX_REVIEW_NOTE_BYTES);
+    text(provenance.contentIdentity);
+    if (provenance.sourceIdentity !== undefined) text(provenance.sourceIdentity);
+    if (provenance.sourceAttested !== undefined && typeof provenance.sourceAttested !== "boolean")
+      throw new Error("Invalid checkpoint source attestation.");
+    for (const side of ["oldContext", "newContext"])
+      if (
+        provenance[side] !== undefined &&
+        (!Array.isArray(provenance[side]) ||
+          (provenance[side] as unknown[]).some((line) => typeof line !== "string"))
+      )
+        throw new Error("Invalid original checkpoint context.");
+    for (const side of ["old", "new"] as const) {
+      const range = (note.anchor as ExtensionReviewCheckpoint["notes"][number]["anchor"])[
+        side === "old" ? "oldRange" : "newRange"
+      ];
+      const context = provenance[side === "old" ? "oldContext" : "newContext"];
+      if (context && (!range || (context as unknown[]).length !== range[1] - range[0] + 1))
+        throw new Error("Checkpoint original context disagrees with its anchor.");
+    }
+    if (provenance.filePath !== note.filePath)
+      throw new Error("Checkpoint changed its original file path.");
+    const file = state.document.files.find((file) => file.key === note.fileKey);
+    if (file && file.path !== provenance.filePath)
+      throw new Error("Checkpoint file identity disagrees with its original path.");
+    if (file?.contentIdentity === provenance.contentIdentity) {
+      for (const side of ["old", "new"] as const) {
+        const range = (note.anchor as ExtensionReviewCheckpoint["notes"][number]["anchor"])[
+          side === "old" ? "oldRange" : "newRange"
+        ];
+        if (!range) continue;
+        const expected = reviewRangeContext(file, side, range);
+        if (
+          expected &&
+          JSON.stringify(expected) !==
+            JSON.stringify(provenance[side === "old" ? "oldContext" : "newContext"])
+        )
+          throw new Error(
+            "Checkpoint original context does not match its claimed source identity.",
+          );
+      }
+    }
+    const {
+      resolution,
+      provenance: origin,
+      tags,
+      status,
+      filePath,
+      fileAvailability,
+      ...fields
+    } = value as ExtensionReviewCheckpoint["notes"][number];
+    void resolution;
+    void filePath;
+    void fileAvailability;
+    const stored = {
+      note: {
+        ...fields,
+        anchor: {
+          ...fields.anchor,
+          intersectingHunkIndices: [...fields.anchor.intersectingHunkIndices],
+        },
+        ...(tags ? { tags: [...tags] } : {}),
+      },
+      provenance: {
+        ...origin,
+        oldContext: origin.oldContext ? [...origin.oldContext] : undefined,
+        newContext: origin.newContext ? [...origin.newContext] : undefined,
+      },
+      resolution: "active" as const,
+      ...(status ? { status } : {}),
+    };
+    if (!reviewNoteWithinSizeLimit(stored.note))
+      throw new Error("Restored human note exceeds its size limit.");
+    if (state.liveNotes.some((entry) => entry.note.id === stored.note.id))
+      throw new Error("Restored human note conflicts with a live identity.");
+    return reconcileStoredReviewNote(stored, state.document);
+  });
+  for (const entry of userNotes) {
+    const seen = new Set<string>([entry.note.id]);
+    let parent = entry.note.parentId;
+    while (parent && ids.has(parent)) {
+      if (seen.has(parent)) throw new Error("Checkpoint contains a cyclic note thread.");
+      seen.add(parent);
+      parent = userNotes.find((entry) => entry.note.id === parent)?.note.parentId;
+    }
+  }
+  const selection = exact(record.selection, ["fileKey", "hunkIndex", "activeNoteId"]);
+  index(selection.hunkIndex);
+  if (selection.fileKey !== null) {
+    text(selection.fileKey);
+    const file = state.document.files.find((file) => file.key === selection.fileKey);
+    if (!file || selection.hunkIndex >= Math.max(1, file.hunks.length))
+      throw new Error("Invalid checkpoint selection.");
+  }
+  if (selection.activeNoteId !== null && !ids.has(selection.activeNoteId as string))
+    throw new Error("Invalid checkpoint active note.");
+  let draftNote: ReviewDraftNote | null = null;
+  if (record.draft !== null) {
+    const draft = exact(
+      record.draft,
+      ["id", "fileKey", "hunkIndex", "side", "line", "body"],
+      ["kind", "targetNoteId", "parentId", "targetKind", "expandedLineSource", "anchor"],
+    );
+    text(draft.id);
+    text(draft.fileKey);
+    index(draft.hunkIndex);
+    index(draft.line, 1);
+    if (typeof draft.body !== "string" || utf8ByteLength(draft.body) > MAX_REVIEW_NOTE_BYTES)
+      throw new Error("Invalid checkpoint draft body.");
+    if (draft.side !== "old" && draft.side !== "new")
+      throw new Error("Invalid checkpoint draft side.");
+    const file = state.document.files.find((file) => file.key === draft.fileKey);
+    if (!file?.hunks[draft.hunkIndex]) throw new Error("Checkpoint draft source is unavailable.");
+    if (draft.kind !== undefined && !["create", "edit", "reply"].includes(String(draft.kind)))
+      throw new Error("Invalid checkpoint composer mode.");
+    if (ids.has(draft.id))
+      throw new Error("Checkpoint draft conflicts with a saved human identity.");
+    if (draft.kind === "edit") {
+      text(draft.targetNoteId);
+      const target = userNotes.find((entry) => entry.note.id === draft.targetNoteId);
+      if (!target || target.note.fileKey !== draft.fileKey || target.resolution === "orphaned")
+        throw new Error("Checkpoint edit target is unavailable.");
+      if (draft.anchor && JSON.stringify(draft.anchor) !== JSON.stringify(target.note.anchor))
+        throw new Error("Checkpoint edit changed the original note anchor.");
+    } else if (draft.targetNoteId !== undefined)
+      throw new Error("Unexpected checkpoint edit identity.");
+    if (draft.kind === "reply") {
+      text(draft.parentId);
+      const parent = userNotes.find((entry) => entry.note.id === draft.parentId);
+      if (parent && parent.note.fileKey !== draft.fileKey)
+        throw new Error("Checkpoint reply belongs to another file.");
+    } else if (draft.parentId !== undefined)
+      throw new Error("Unexpected checkpoint reply identity.");
+    if (draft.expandedLineSource !== undefined) {
+      const source = exact(draft.expandedLineSource, ["sourceAttested"], ["sourceIdentity"]);
+      if (
+        source.sourceAttested !== true ||
+        file.sourceAttested !== true ||
+        source.sourceIdentity !== file.sourceIdentity
+      )
+        throw new Error("Checkpoint expanded source is unattested or changed.");
+    }
+    if (!reviewLineCoveredByHunks(file.hunks, draft.side, draft.line)) {
+      if (!draft.expandedLineSource)
+        throw new Error("Checkpoint draft has no exact source authority.");
+      const proof = [
+        reviewGapId("before", draft.hunkIndex),
+        reviewGapId("trailing", draft.hunkIndex),
+      ].some((gapId) =>
+        resolveReviewExpandedLine(file, {
+          gapId,
+          side: draft.side as "old" | "new",
+          line: draft.line as number,
+          sourceIdentity: file.sourceIdentity!,
+        }),
+      );
+      if (!proof) throw new Error("Checkpoint draft context is unavailable.");
+    }
+    if (
+      draft.targetKind !== undefined &&
+      draft.targetKind !== "line" &&
+      draft.targetKind !== "range"
+    )
+      throw new Error("Invalid checkpoint target kind.");
+    if (draft.anchor) {
+      anchor(draft.anchor);
+      const target = (record.draft as ReviewDraftNote).anchor!;
+      if (
+        !target.preferred ||
+        (!draft.expandedLineSource &&
+          reviewRangeTargetCoverageIssue(file.hunks, { ...target, preferred: target.preferred }))
+      )
+        throw new Error("Checkpoint draft context is unavailable.");
+    }
+    draftNote = record.draft as ReviewDraftNote;
+  }
+  return {
+    userNotes,
+    draftNote,
+    selection: { fileKey: selection.fileKey as string | null, hunkIndex: selection.hunkIndex },
+    activeNoteId: selection.activeNoteId as string | null,
+  };
+}
diff --git a/packages/hunk/src/core/review/controller.test.ts b/packages/hunk/src/core/review/controller.test.ts
