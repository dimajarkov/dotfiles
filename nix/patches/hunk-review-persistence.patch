+/** Inspect saved notes through the public extension snapshot after a native refresh. */
+const INSPECT_EXTENSION = `export default function (hunk) {
+  hunk.registerCommand({ id: "inspect", title: "Inspect review", key: "f9" }, (ctx) => {
+    const snapshot = ctx.review.snapshot();
