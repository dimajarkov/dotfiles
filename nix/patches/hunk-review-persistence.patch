+test("mouse save waits for durable acknowledgement and preserves typing during a pending write", async () => {
+  const configHome = harness.createIsolatedConfigHome();
+  const fixture = harness.createTwoFileRepoFixture();
+  const extension = join(configHome, "persistence.ts");
