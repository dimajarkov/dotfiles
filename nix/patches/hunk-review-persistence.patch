+/** Exercise transitions and disposition through public extension command controls. */
+const TRANSITION_EXTENSION = `
+import { existsSync, readFileSync, writeFileSync } from "node:fs";
+import { join, resolve } from "node:path";
+export default function (hunk) {
+  hunk.registerReviewPersistence({
+    async open(context) {
+      const path = join(process.env.XDG_CONFIG_HOME, context.documentIdentity + ".json");
+      return { reviewId: context.documentIdentity, checkpoint: existsSync(path) ? JSON.parse(readFileSync(path, "utf8")) : null };
+    },
+    async write(checkpoint) { writeFileSync(join(process.env.XDG_CONFIG_HOME, checkpoint.reviewId + ".json"), JSON.stringify(checkpoint)); },
+  });
+  for (const [key, mode, value] of [["f8", "automatic", 9], ["f7", "explicit", 9], ["f4", "explicit", 2]]) {
+    hunk.registerCommand({ id: key, title: key, key }, async ctx => {
+      const snapshot = ctx.review.snapshot();
+      const text = "diff --git a/alpha.ts b/alpha.ts\\n--- a/alpha.ts\\n+++ b/alpha.ts\\n@@ -1 +1 @@\\n-export const alpha = 1;\\n+export const alpha = " + value + ";\\n";
+      const result = await ctx.review.requestReload({ mode, expected: snapshot, source: { kind: "patch", text } });
+      ctx.notify("TRANSITION " + key + " " + (result.ok ? "ok" : result.reason));
+    });
+  }
+  hunk.registerCommand({ id: "resolve", title: "Resolve note", key: "f6" }, async ctx => {
+    const snapshot = ctx.review.snapshot();
+    const result = await ctx.review.setNoteStatus(snapshot.notes[0].id, "resolved", snapshot);
+    ctx.notify("STATUS " + (result.ok ? "ok" : result.reason));
+  });
+  hunk.registerCommand({ id: "inspect", title: "Inspect notes", key: "f9" }, ctx => {
+    ctx.notify("INSPECT " + ctx.review.snapshot().notes.map(n => n.source + ":" + n.status + ":" + n.summary).join("|"));
+  });
+}`;
