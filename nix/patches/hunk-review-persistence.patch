+    ],
+    { env, stdout: "pipe", stderr: "pipe" },
+  );
+  const [output, errors, code] = await Promise.all([
+    new Response(process.stdout).text(),
+    new Response(process.stderr).text(),
+    process.exited,
+  ]);
+  if (code) throw new Error(errors);
+  return JSON.parse(output);
+}
