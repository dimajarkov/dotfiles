+    const saved = await session.waitForText(/Your note/);
+    expect(saved).toContain("Newer typing.");
+    const durable = JSON.parse(readFileSync(join(configHome, "checkpoint.json"), "utf8"));
+    expect(durable.notes).toHaveLength(1);
+    expect(durable.notes[0].summary).toContain("Newer typing.");
+    expect(durable.draft).toBeNull();
+  } finally {
+    writeFileSync(release, "ready");
+    session.close();
+  }
+});
