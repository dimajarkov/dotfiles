+  writeFileSync(
+    extension,
+    PERSISTENCE_EXTENSION.replace(
+      "writeFileSync(checkpointPath, JSON.stringify(checkpoint));",
+      `if (checkpoint.notes.length) {
+        writeFileSync(join(process.env.XDG_CONFIG_HOME, "save-started"), "ready");
+        while (!existsSync(join(process.env.XDG_CONFIG_HOME, "release-save"))) await new Promise(resolve => setTimeout(resolve, 20));
+      }
