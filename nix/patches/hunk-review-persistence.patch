diff --git a/packages/hunk/src/core/review/reconciliation.ts b/packages/hunk/src/core/review/reconciliation.ts
new file mode 100644
index 00000000..d950b034
--- /dev/null
+++ b/packages/hunk/src/core/review/reconciliation.ts
@@ -0,0 +1,87 @@
+/** Retains original note context and checks it at its exact address after reloads. */
+import { reviewExpansionSide } from "./expansion";
+import { normalizedReviewSourceLines, reviewRangeCoveredByHunks } from "./geometry";
+import type { ReviewStoredNote, ReviewSourceStatus } from "./state";
+import type { ReviewDocumentV1, ReviewFileV1, ReviewLineRange, ReviewSide } from "./types";
+
+/** Read an exact patch-backed range using the parser's per-side origins. */
+export function reviewRangeContext(file: ReviewFileV1, side: ReviewSide, range: ReviewLineRange) {
+  if (!reviewRangeCoveredByHunks(file.hunks, side, range)) return undefined;
+  const lines = side === "old" ? file.deletionLines : file.additionLines;
+  const result: string[] = [];
+  for (let line = range[0]; line <= range[1]; line++) {
+    const hunk = file.hunks.find((candidate) => {
+      const start = side === "old" ? candidate.deletionStart : candidate.additionStart;
+      const count = side === "old" ? candidate.deletionCount : candidate.additionCount;
+      return line >= start && line < start + count;
+    });
+    if (!hunk) return undefined;
+    const start = side === "old" ? hunk.deletionStart : hunk.additionStart;
+    const origin = side === "old" ? hunk.deletionLineIndex : hunk.additionLineIndex;
+    const text = lines[origin + line - start];
+    if (text === undefined) return undefined;
+    result.push(text);
+  }
+  return result;
+}
+
+/** Capture context once; editing or reloading a note cannot change its provenance. */
+export function retainReviewNoteProvenance(
+  entry: ReviewStoredNote,
+  document: ReviewDocumentV1,
+  sourceStatus?: ReviewSourceStatus,
+): ReviewStoredNote {
+  if (entry.provenance) return entry;
+  const file = document.files.find((candidate) => candidate.key === entry.note.fileKey);
+  if (!file) return entry;
+  const { oldRange, newRange } = entry.note.anchor;
+  const sourceLines =
+    sourceStatus?.kind === "loaded" ? normalizedReviewSourceLines(sourceStatus.text) : undefined;
+  const expandedSide = reviewExpansionSide(file.changeKind);
+  const context = (side: ReviewSide, range: ReviewLineRange) =>
+    reviewRangeContext(file, side, range) ??
+    (sourceLines && side === expandedSide && range[1] <= sourceLines.length
+      ? sourceLines.slice(range[0] - 1, range[1])
+      : undefined);
+  return {
+    ...entry,
+    provenance: {
+      filePath: file.path,
+      contentIdentity: file.contentIdentity,
+      ...(file.sourceIdentity !== undefined ? { sourceIdentity: file.sourceIdentity } : {}),
+      ...(file.sourceAttested !== undefined ? { sourceAttested: file.sourceAttested } : {}),
+      ...(oldRange ? { oldContext: context("old", oldRange) } : {}),
+      ...(newRange ? { newContext: context("new", newRange) } : {}),
+    },
+  };
+}
+
+/** Classify original context without searching, relocating, or rewriting the anchor. */
+export function reconcileStoredReviewNote(
+  entry: ReviewStoredNote,
+  document: ReviewDocumentV1,
+): ReviewStoredNote {
+  const file = document.files.find((candidate) => candidate.key === entry.note.fileKey);
+  const origin = entry.provenance;
+  let resolution: ReviewStoredNote["resolution"] = "orphaned";
+  if (file && origin) {
+    const { oldRange, newRange } = entry.note.anchor;
+    const exactSource =
+      file.sourceAttested === true &&
+      origin.sourceAttested === true &&
+      file.sourceIdentity !== undefined &&
+      file.sourceIdentity === origin.sourceIdentity;
+    const missing = (["old", "new"] as const).some((side) => {
+      const range = side === "old" ? oldRange : newRange;
+      return range && !reviewRangeContext(file, side, range) && !exactSource;
+    });
+    if (!missing) {
+      const exact =
+        file.contentIdentity === origin.contentIdentity &&
+        file.sourceIdentity === origin.sourceIdentity &&
+        file.sourceAttested === origin.sourceAttested;
+      resolution = exact ? "active" : "stale";
+    }
+  }
+  return resolution === entry.resolution ? entry : { ...entry, resolution };
+}
