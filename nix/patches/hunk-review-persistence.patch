+
+/** Supply an extension-owned durable directory, with storage failure at the public port. */
+const PERSISTENCE_EXTENSION = `
+import { existsSync, readFileSync, writeFileSync } from "node:fs";
+import { join, resolve } from "node:path";
+export default function (hunk) {
+  const checkpointPath = join(process.env.XDG_CONFIG_HOME, "checkpoint.json");
+  hunk.registerReviewPersistence({
+    async open(context) {
+      return { reviewId: "immutable-fixture", checkpoint: existsSync(checkpointPath) ? JSON.parse(readFileSync(checkpointPath, "utf8")) : null };
+    },
+    async write(checkpoint) {
+      if (process.env.HUNK_TEST_PERSIST_FAIL === "1") throw new Error("fixture disk unavailable");
+      writeFileSync(checkpointPath, JSON.stringify(checkpoint));
+      if (process.env.HUNK_TEST_CRASH_DRAFT && process.env.HUNK_TEST_CRASH_DRAFT === checkpoint.draft?.body) process.kill(process.pid, "SIGKILL");
+    },
+  });
+  hunk.registerCommand({ id: "inspect", title: "Inspect checkpoint", key: "f9" }, ctx => {
+    const snapshot = ctx.review.snapshot();
+    ctx.notify("INSPECT " + snapshot.notes.map(n => n.source + ":" + n.summary).join("|") + " selection:" + ctx.selection.file?.path);
+  });
+}`;
+
+/** Exercise independent viewer versions through the actual factory and lifecycle context. */
+const HANDOFF_EXTENSION = `
+import { existsSync, readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+export default function (hunk) {
+  const path = join(process.env.XDG_CONFIG_HOME, "handoff.json");
+  const read = () => existsSync(path) ? JSON.parse(readFileSync(path, "utf8")) : { version: 0, checkpoint: null };
+  let expectedVersion;
+  hunk.registerReviewPersistence({
+    async open() {
+      const current = read();
+      expectedVersion = current.version;
+      return { reviewId: "immutable-handoff", checkpoint: current.checkpoint };
+    },
+    async write(checkpoint) {
+      const current = read();
+      if (current.version !== expectedVersion) throw new Error("Competing viewer checkpoint");
+      writeFileSync(path, JSON.stringify({ version: ++expectedVersion, checkpoint }));
+    },
+  });
+  hunk.on("changeset_loaded", (_event, ctx) => {
+    writeFileSync(join(process.env.XDG_CONFIG_HOME, "loaded-" + process.env.HUNK_TEST_VIEWER), JSON.stringify(Object.keys(ctx.review)));
+  });
+  hunk.registerCommand({ id: "inspect", title: "Inspect adoption", key: "f9" }, ctx => {
+    const current = ctx.review.checkpoint();
+    ctx.notify("ADOPTION " + (JSON.stringify(current) === JSON.stringify(read().checkpoint) ? "durable" : "obsolete"));
+  });
+}`;
+
+/** Pause storage reads and adoption writes while retaining each native writer's original CAS. */
+const CANCELED_ADOPTION_EXTENSION = `
+import { existsSync, readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+export default function (hunk) {
+  const root = process.env.XDG_CONFIG_HOME;
+  const path = join(root, "adoption.json");
+  const read = () => existsSync(path) ? JSON.parse(readFileSync(path, "utf8")) : { version: 0, checkpoint: null };
+  const writers = new Map();
+  let opened;
+  let opens = 0;
+  const wait = async (name) => {
+    writeFileSync(join(root, name + "-started"), "ready");
+    while (!existsSync(join(root, "release-" + name))) await new Promise(resolve => setTimeout(resolve, 10));
+  };
+  hunk.registerReviewPersistence({
+    async open() {
+      const current = read();
+      if (++opens > 1) await wait("read-" + opens);
+      opened = { version: current.version };
+      return { reviewId: "immutable-adoption", checkpoint: current.checkpoint };
+    },
+    async write(checkpoint) {
+      const owner = writers.get(checkpoint.generation) ?? opened;
+      writers.set(checkpoint.generation, owner);
+      if (existsSync(join(root, "fail-ack"))) throw new Error("Transient adoption checkpoint failure");
+      if (existsSync(join(root, "pause-ack")) && !existsSync(join(root, "release-ack"))) await wait("ack");
+      const current = read();
+      if (current.version !== owner.version) throw new Error("Competing checkpoint write");
+      writeFileSync(path, JSON.stringify({ version: ++owner.version, checkpoint }));
+    },
+  });
+  hunk.registerCommand({ id: "reload", title: "Reload immutable review", key: "f8" }, async ctx => {
+    const result = await ctx.review.requestReload({ mode: "explicit", expected: ctx.review.snapshot() });
+    ctx.notify("ADOPTION " + (result.ok ? "ok" : result.reason));
+  });
+}`;
