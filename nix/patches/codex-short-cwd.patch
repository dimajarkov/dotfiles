+mod short_directory_tests {
+    use super::format_short_directory;
+    use pretty_assertions::assert_eq;
+    use std::path::Path;
+
+    #[test]
+    fn keeps_only_the_last_two_folders() {
+        for (path, expected) in [
+            ("/Users/dmitrijarkov/dev/tools/codex", "tools/codex"),
+            ("/Users/dmitrijarkov", "Users/dmitrijarkov"),
+            ("/tmp", "tmp"),
+            ("/", "/"),
+            ("/some parent/child folder/", "some parent/child folder"),
+            ("/a/папка/проект", "папка/проект"),
+        ] {
+            assert_eq!(format_short_directory(Path::new(path)), expected);
+        }
+    }
+
+    #[test]
+    fn short_directory_snapshot() {
+        insta::assert_snapshot!(format_short_directory(Path::new("/Users/dmitrijarkov/dev/tools/codex")), @"tools/codex");
