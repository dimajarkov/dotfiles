+/// Display only the parent and current folder in the status line.
+pub(crate) fn format_short_directory(directory: &Path) -> String {
+    let Some(child) = directory.file_name() else {
+        return directory.display().to_string();
+    };
+    match directory.parent().and_then(Path::file_name) {
+        Some(parent) => Path::new(parent).join(child).display().to_string(),
+        None => child.to_string_lossy().into_owned(),
+    }
+}
