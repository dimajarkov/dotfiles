+function containsRuleBody(messages: readonly { content?: unknown }[], body: string): boolean {
+	return messages.some(({ content }) => {
+		if (typeof content === "string") return content.includes(body);
+		if (!Array.isArray(content)) return false;
+		return content.some(
+			(part) => part?.type === "text" && typeof part.text === "string" && part.text.includes(body),
+		);
+	});
+}
