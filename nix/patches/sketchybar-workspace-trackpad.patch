+// Opt in only subscribed workspace items. Other controls and global scroll events
+// keep the upstream vertical-only contract, including its existing debounce.
+static bool workspace_scroll(void* context, struct bar_item* item,
+                             uint32_t modifier) {
+  if (!item || !item->name || strncmp(item->name, "wsc.", 4)
+      || !(item->update_mask & UPDATE_MOUSE_SCROLLED)) return false;
+
+  // Each viewport is explicitly associated with exactly one display. Key by its
+  // native display mask, not the hovered item's window: scrolling can move items
+  // under a stationary pointer. Ambiguous/unassigned items keep legacy behavior.
+  uint32_t display = item->associated_display;
+  if (!display || (display & (display - 1))) return false;
+  unsigned index = 0;
+  while ((display >>= 1)) ++index;
+  static struct workspace_scroll_state {
+    uint64_t timestamp, emitted;
+    double x, y;
+  } states[32];
+  struct workspace_scroll_state* state = &states[index];
+  uint64_t now = clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW_APPROX);
+  int phase = CGEventGetIntegerValueField(context, kCGScrollWheelEventScrollPhase);
+  if (now > state->timestamp + 2*SCROLL_TIMEOUT || (phase & kCGScrollPhaseBegan))
+    state->x = state->y = 0;
+  // Gesture boundaries reset fractions, never the per-display throttle deadline.
+  state->timestamp = now;
+  // Ignore inertial tails: a deliberate gesture browses, momentum cannot run away.
+  if (CGEventGetIntegerValueField(context, kCGScrollWheelEventMomentumPhase)
+      || (phase & (kCGScrollPhaseEnded | kCGScrollPhaseCancelled))) {
+    state->x = state->y = 0;
+    return true;
+  }
+
+  bool continuous = CGEventGetIntegerValueField(context, kCGScrollWheelEventIsContinuous);
+  double x = continuous
+    ? CGEventGetDoubleValueField(context, kCGScrollWheelEventFixedPtDeltaAxis2)
+    : CGEventGetIntegerValueField(context, kCGScrollWheelEventDeltaAxis2);
+  double y = continuous
+    ? CGEventGetDoubleValueField(context, kCGScrollWheelEventFixedPtDeltaAxis1)
+    : CGEventGetIntegerValueField(context, kCGScrollWheelEventDeltaAxis1);
+  // A reversal cancels pending motion instead of replaying an old direction.
+  if (x * state->x < 0) state->x = 0;
+  if (y * state->y < 0) state->y = 0;
+  state->x += x;
+  state->y += y;
+  double ax = state->x < 0 ? -state->x : state->x;
+  double ay = state->y < 0 ? -state->y : state->y;
+  if ((ax < 1.0 && ay < 1.0) || now < state->emitted + SCROLL_TIMEOUT) return true;
+
+  // One dominant axis per dispatch, never two steps for a diagonal gesture.
+  if (ax > ay) bar_item_on_scroll_x(item, state->x > 0 ? 1 : -1, modifier);
+  else bar_item_on_scroll(item, state->y > 0 ? 1 : -1, modifier);
+  state->x = state->y = 0;
+  state->emitted = now;
+  if (item->needs_update) bar_manager_refresh(&g_bar_manager, false, false);
+  return true;
+}
