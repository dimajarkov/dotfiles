{
  "name": "hunk-turn-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun run build && bun test",
    "typecheck": "node typecheck-pi-adapter.mjs",
    "lint": "oxlint --deny-warnings . \"$(node -e 'process.stdout.write(require(\"node:fs\").realpathSync(\"../../../.pi/agent/extensions/hunk-turn-review\"))')\" \"$(node -e 'process.stdout.write(require(\"node:fs\").realpathSync(\"../../../.codex/hunk-turn-review\"))')\"",
    "format": "oxfmt . \"$(node -e 'process.stdout.write(require(\"node:fs\").realpathSync(\"../../../.pi/agent/extensions/hunk-turn-review\"))')\" \"$(node -e 'process.stdout.write(require(\"node:fs\").realpathSync(\"../../../.codex/hunk-turn-review\"))')\"",
    "format:check": "oxfmt --check . \"$(node -e 'process.stdout.write(require(\"node:fs\").realpathSync(\"../../../.pi/agent/extensions/hunk-turn-review\"))')\" \"$(node -e 'process.stdout.write(require(\"node:fs\").realpathSync(\"../../../.codex/hunk-turn-review\"))')\""
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.14"
}
