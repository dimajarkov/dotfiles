#!/bin/sh
set -eu

repo="$HOME/dev/tools/chrome-devtools-axi"

# Route Axi to the dedicated Arc browser target instead of inherited Chrome
# auto-connect state from an older bridge or shell session.
unset \
  CHROME_DEVTOOLS_AXI_AUTO_CONNECT \
  CHROME_DEVTOOLS_AXI_BROWSER_URL \
  CHROME_DEVTOOLS_AXI_CHANNEL \
  CHROME_DEVTOOLS_AXI_PORT \
  CHROME_DEVTOOLS_AXI_USER_DATA_DIR
export CHROME_DEVTOOLS_AXI_EXECUTABLE_PATH="/Applications/Arc.app/Contents/MacOS/Arc"
export CHROME_DEVTOOLS_AXI_HEADED=1
export CHROME_DEVTOOLS_AXI_SESSION=computer-use

# Focus the named Arc space when macOS grants scripting access.
/usr/bin/osascript <<'APPLESCRIPT' >/dev/null 2>&1 || :
tell application "Arc"
  repeat with browserWindow in windows
    repeat with browserSpace in spaces of browserWindow
      if (title of browserSpace) is "computer use" then
        focus browserSpace
        return
      end if
    end repeat
  end repeat
end tell
APPLESCRIPT

exec "$repo/node_modules/.bin/tsx" "$repo/bin/chrome-devtools-axi.ts" "$@"
