{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/config/settings.schema.json",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "xhigh",
  "enabledModels": [
    "openai-codex/*"
  ],
  "theme": "github-dark-default",
  "externalEditor": "nvim",
  "defaultProjectTrust": "ask",
  "quietStartup": true,
  "hideThinkingBlock": true,
  "showCacheMissNotices": false,
  "editorPaddingX": 1,
  "outputPad": 0,
  "autocompleteMaxVisible": 8,
  "tuiMode": "fullscreen",
  "steeringMode": "all",
  "followUpMode": "all",
  "collapseChangelog": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 149600,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "terminal": {
    "showImages": false,
    "imageWidthCells": 60,
    "clearOnShrink": false
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "packages": [
    "npm:@ryan_nookpi/pi-extension-codex-fast-mode@0.2.8",
    "npm:pi-mcp-adapter@2.20.1",
    "npm:pi-web-access@0.33.0",
    "npm:@tunglam/pi-inline-skills@0.1.3",
    "npm:@plannotator/pi-extension@0.27.23",
    "npm:pi-image-view@0.4.0",
    "npm:@narumitw/pi-goal@0.54.8"
  ],
  "extensions": [
    "-builtin:mcp",
    "-extensions/ask-user/index.ts",
    "-extensions/subagents/index.ts"
  ],
  "skills": [
    "~/.agents/skills"
  ],
  "recentModels": [
    "openai-codex/gpt-6.1-sol"
  ],
  "fullscreenScrollbar": "auto",
  "lastChangelogVersion": "1.1.0",
  "treeFilterMode": "default"
}