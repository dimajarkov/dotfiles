{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/config/settings.schema.json",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "xhigh",
  "enabledModels": [
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra"
  ],
  "theme": "prime",
  "externalEditor": "nvim",
  "defaultProjectTrust": "ask",
  "quietStartup": true,
  "hideThinkingBlock": true,
  "showCacheMissNotices": false,
  "editorPaddingX": 1,
  "outputPad": 0,
  "autocompleteMaxVisible": 8,
  "tuiMode": "fullscreen",
  "steeringMode": "all",
  "followUpMode": "all",
  "collapseChangelog": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 149600,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "terminal": {
    "showImages": false,
    "imageWidthCells": 60,
    "clearOnShrink": false
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "packages": [
    "npm:@ryan_nookpi/pi-extension-codex-fast-mode@0.2.6",
    "npm:pi-mcp-adapter@2.11.0",
    "npm:pi-web-access@0.15.0",
    "npm:@tunglam/pi-inline-skills@0.1.3",
    "git:github.com/tintinweb/pi-subagents@e955e29c51b7a6cce37e1108cd2d6c57a77e151c"
  ],
  "skills": [
    "~/.agents/skills"
  ],
  "recentModels": [
    "openai-codex/gpt-5.6-luna"
  ],
  "fullscreenScrollbar": "auto",
  "lastChangelogVersion": "0.85.0"
}