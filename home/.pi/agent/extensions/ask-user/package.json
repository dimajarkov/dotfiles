{
  "name": "pi-ask-user",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types *.test.ts",
    "lint": "oxlint --deny-warnings index.ts prompt.ts *.test.ts",
    "format": "oxfmt index.ts prompt.ts *.test.ts package.json tsconfig.json",
    "format:check": "oxfmt --check index.ts prompt.ts *.test.ts package.json tsconfig.json"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "@types/node": "22.19.19",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.14.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
