{
  "model": "haiku",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "lavish-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gh-axi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "theme": "dark",
  "verbose": true,
  "autoScrollEnabled": true,
  "defaultView": "transcript"
}
